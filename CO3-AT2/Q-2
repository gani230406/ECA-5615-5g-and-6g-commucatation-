clc;
clear;
close all;

% AI-Assisted Healthcare Diagnosis

numPatients = 10;

% Generate Health Scores
healthScore = randi([40 100],1,numPatients);

% AI Diagnosis
diagnosis = cell(1,numPatients);

for i = 1:numPatients
    if healthScore(i) >= 70
        diagnosis{i} = 'Healthy';
    else
        diagnosis{i} = 'Needs Attention';
    end
end

disp('Health Scores');
disp(healthScore);

disp('AI Diagnosis');
disp(diagnosis');

% Count Results
healthyCount = sum(healthScore >= 70);
attentionCount = sum(healthScore < 70);

% Figure 1: Health Scores
figure;
bar(healthScore);
title('Patient Health Scores');
xlabel('Patient ID');
ylabel('Health Score');
grid on;

% Figure 2: Diagnosis Distribution
figure;
pie([healthyCount attentionCount]);
legend('Healthy','Needs Attention');
title('AI Diagnosis Results');

% Figure 3: Wireless Communication Workflow
figure;
plot(1:numPatients,healthScore,'o-','LineWidth',2);
title('Wireless Transmission to AI Diagnosis Center');
xlabel('Patient ID');
ylabel('Health Score');
grid on;

% Display Summary
fprintf('\nHealthy Patients = %d\n', healthyCount);
fprintf('Patients Needing Attention = %d\n', attentionCount);
